{
    "name": "Variant List",
    "template": "{{#unless _.data.site.product}}\n    <div>Select a product in Page Builder to populate this widget</div>\n{{else}}\n    <div style=\"width:100%\">\n        <img \n        srcset=\"{{_.data.site.product.defaultImage.url320wide}} 320w,\n        {{_.data.site.product.defaultImage.url640wide}} 640w,\n        {{_.data.site.product.defaultImage.url960wide}} 960w,\n        {{_.data.site.product.defaultImage.url960wide}} 1280w\"\n        sizes=\"(max-width: 600px) 320px,\n        960px\"\n        src=\"{{_.data.site.product.defaultImage.url960wide}}\"\n        style=\"display: block;max-width: 66%; margin-left:auto; margin-right:auto\" />\n        </div>\n        <div style=\"display: block;margin-left:auto; margin-right:auto;\">\n            <strong style=\"display: block;\">{{_.data.site.product.name}}</strong>\n            <em style=\"display: block;\">{{_.data.site.product.plainTextDescription}}</em>\n            <ul style=\"list-style: none;\">\n            {{#each _.data.site.product.variants.edges }}\n                <li>\n                    <div style=\"display:flex;flex-direction: row\">\n                        <div style=\"width:160px;flex-grow: 1\">\n                            {{#if node.defaultImage}}\n                            <img src=\"{{node.defaultImage.url160wide}}\"/>\n                            {{/if}}\n                        </div>\n                        <div style=\"flex-grow: 1\">\n                            <span>\n                                {{toFixed node.prices.price.value 2}} {{node.prices.price.currencyCode}} \n                            </span>\n                        </div>\n                        <div style=\"flex-grow: 3\">\n                            <strong>{{node.sku}}</strong>\n                        </div>\n                    </div>\n                </li>\n            {{/each}}\n            </ul>\n        </div>\n    </div>\n{{/unless}}",
    "create_new_version": true
}