			"name": "Schema",
			"item": [
				{
					"name": "Create Widget Template (Static Image + Content)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"packages": {},
								"exec": [
									"pm.test(\"Response is not an error\", () => {",
