									"});",
									"",
									"const uuid = pm.response.json().data?.uuid;",
									"if (uuid) {",
									"    pm.environment.unset(\"widget_template_uuid\");",
									"    pm.environment.set(\"widget_template_uuid\", uuid);",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "Content-Type",
								"value": "application/json",
								"type": "text"
							},
							{
								"key": "X-Auth-Token",
								"value": "{{v3_token}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n\t\"name\": \"Static Image + Content\",\n\t\"schema\": [\n        {\n            \"type\": \"tab\",\n            \"label\": \"Static Content\",\n            \"sections\": [\n                {\n                    \"label\": \"Static Content\",\n                    \"settings\": [\n                        {\n                            \"type\": \"input\",\n                            \"id\": \"heading_text\",\n                            \"label\": \"Heading Text\",\n                            \"default\": \"Type a Heading\"\n                        },\n                        {\n                            \"type\": \"imageManager\",\n                            \"id\": \"image\",\n                            \"label\": \"Image\",\n                            \"default\": {\n                                \"src\": \"https://placehold.it/250x250\",\n                                \"type\": \"IMAGE_MANAGER\"\n                            }\n                        },\n                        {\n                            \"type\": \"range\",\n                            \"label\": \"Image Width\",\n                            \"id\": \"width\",\n                            \"default\": \"250\",\n                            \"typeMeta\": {\n                                \"rangeValues\": {\n                                    \"min\": 100,\n                                    \"max\": 1200,\n                                    \"step\": 1,\n                                    \"unit\": \"px\"\n                                }\n                            }\n                        },\n                        {\n                            \"type\": \"text\",\n                            \"label\": \"Text Block Content\",\n                            \"id\": \"text_block\",\n                            \"default\": \"Add your promotional or informational text for this widget region.\"\n                        }\n                    ]\n                }\n            ]\n        }\n    ],\n    \"template\": \"<h2>{{heading_text}}</h2>\\n<img src=\\\"{{image.src}}\\\" width=\\\"{{width}}\\\" />\\n<div>{{text_block}}</div>\"\n}\n",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "https://api.bigcommerce.com/stores/{{store_hash}}/v3/content/widget-templates",
							"protocol": "https",
							"host": [
								"api",
								"bigcommerce",
								"com"
							],
							"path": [
								"stores",
								"{{store_hash}}",
								"v3",
								"content",
								"widget-templates"
							]
						},
						"description": "Creates the Static Image + Content widget template from the schema lab. On success, the UUID in the response is saved to the `widget_template_uuid` environment variable, so the requests that need it are filled in for you."
					},
					"response": []
				}
			]
		},
